# Copy to deploy/.env.docker before running docker compose
NODE_ENV=production

# Backend
PORT=4001
OCPP_WS_PORT=9000
OCPP_WS_PATH=/ocpp
PRICE_PER_KWH=15
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password
MAYA_ENV=sandbox
MAYA_PUBLIC_KEY=pk-...
MAYA_SECRET_KEY=sk-...
MAYA_API_BASE_URL=https://pg-sandbox.paymaya.com
MAYA_WEBHOOK_TOKEN=
GUEST_APP_URL=http://guest.stratacore.tech
CORS_ALLOWED_ORIGINS=http://admin.stratacore.tech,http://guest.stratacore.tech
REDIS_URL=redis://redis:6379

STATION_NAME=Stratacore Charging Station
STATION_LOCATION=On-prem site
CHARGERS_JSON=[{"chargerId":"DELTA123","connectorId":1,"chargerIp":"192.168.137.51"},{"chargerId":"DELTA124","connectorId":1,"chargerIp":"192.168.137.52"},{"chargerId":"DELTA125","connectorId":1,"chargerIp":"192.168.137.53"}]

# Watchdog autostart (Phase 2.7)
CHARGE_START_TIMEOUT_MS=60000
STALE_SESSION_THRESHOLD_MINUTES=10
STALE_SESSION_CHECK_INTERVAL_SECONDS=60
STALE_SESSION_MAX_RECOVERY_PER_CYCLE=10
STALE_SESSION_AUTOSTART=1
WATCHDOG_AUTOSTART=1
WATCHDOG_CHECK_INTERVAL_SECONDS=30
WATCHDOG_RESTART_COOLDOWN_SECONDS=60
WATCHDOG_MAX_RESTARTS_PER_HOUR=5
HEALTH_MONITOR_AUTOSTART=1
HEALTH_MONITOR_THRESHOLD=80
HEALTH_MONITOR_INTERVAL_SECONDS=30

# Frontend build/runtime
NEXT_PUBLIC_BACKEND_URL=http://api.stratacore.tech
NEXT_PUBLIC_STATION_NAME=Stratacore Charging Station
NEXT_PUBLIC_STATION_LOCATION=
NEXT_PUBLIC_CHARGERS=[{"chargerId":"DELTA123","connectorId":1,"chargerIp":"192.168.137.51"},{"chargerId":"DELTA124","connectorId":1,"chargerIp":"192.168.137.52"},{"chargerId":"DELTA125","connectorId":1,"chargerIp":"192.168.137.53"}]
