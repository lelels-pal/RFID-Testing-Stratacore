[Unit]
Description=Stratacore Backend API (NestJS + OCPP)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=stratacore
Group=stratacore
WorkingDirectory=/opt/stratacore/apps/backend
Environment=NODE_ENV=production
ExecStart=/usr/bin/node dist/main.js
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=stratacore-backend

[Install]
WantedBy=multi-user.target
