# Copy each block into the matching app's .env file for production.
# Replace secrets before going live.

# --- apps/backend/.env ---
PORT=4001
OCPP_WS_PORT=9000
OCPP_WS_PATH=/ocpp
GUEST_APP_URL=https://guest.stratacore.tech
CORS_ALLOWED_ORIGINS=https://admin.stratacore.tech,https://guest.stratacore.tech
JWT_SECRET=change-me-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production
PRICE_PER_KWH=15
REDIS_URL=redis://localhost:6379

MAYA_ENV=production
MAYA_PUBLIC_KEY=pk-...
MAYA_SECRET_KEY=sk-...
MAYA_API_BASE_URL=https://pg.paymaya.com
MAYA_WEBHOOK_TOKEN=

CHARGERS_JSON=[{"chargerId":"DELTA123","connectorId":1,"chargerIp":"192.168.137.51"},{"chargerId":"DELTA124","connectorId":1,"chargerIp":"192.168.137.52"},{"chargerId":"DELTA125","connectorId":1,"chargerIp":"192.168.137.53"}]

STALE_SESSION_AUTOSTART=1
WATCHDOG_AUTOSTART=1
HEALTH_MONITOR_AUTOSTART=1

# --- apps/kiosk/.env.local ---
NEXT_PUBLIC_BACKEND_URL=https://api.stratacore.tech
NEXT_PUBLIC_STATION_NAME=Charging Station
NEXT_PUBLIC_STATION_LOCATION=
NEXT_PUBLIC_CHARGERS=[{"chargerId":"DELTA123","connectorId":1,"chargerIp":"192.168.137.51"},{"chargerId":"DELTA124","connectorId":1,"chargerIp":"192.168.137.52"},{"chargerId":"DELTA125","connectorId":1,"chargerIp":"192.168.137.53"}]

# --- apps/guest-app/.env.local ---
NEXT_PUBLIC_BACKEND_URL=https://api.stratacore.tech

# --- Charger OCPP endpoint (configure on the physical charger) ---
# wss://ocpp.stratacore.tech/ocpp/<chargerId>
