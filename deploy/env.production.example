# Copy each block into the matching app's .env file for production.
# Replace secrets before going live.

# --- apps/backend/.env ---
PORT=4001
OCPP_WS_PORT=9000
OCPP_WS_PATH=/ocpp
GUEST_APP_URL=https://guest.stratacore.tech
CORS_ALLOWED_ORIGINS=https://admin.stratacore.tech,https://guest.stratacore.tech
JWT_SECRET=change-me-in-production
PAYNAMICS_WEBHOOK_SECRET=change-me-in-production
PAYNAMICS_CHECKOUT_URL=https://www.paynamics.net/webpaymentservice/checkout
PRICE_PER_KWH=15

# --- apps/kiosk/.env.local ---
NEXT_PUBLIC_BACKEND_URL=https://api.stratacore.tech
NEXT_PUBLIC_KIOSK_USERNAME=admin
NEXT_PUBLIC_KIOSK_PASSWORD=change-me-in-production
NEXT_PUBLIC_STATION_NAME=Charging Station
NEXT_PUBLIC_STATION_LOCATION=
NEXT_PUBLIC_CHARGERS=[{"chargerId":"DELTA123","connectorId":1,"chargerIp":"192.168.137.51"}]

# --- apps/guest-app/.env.local ---
NEXT_PUBLIC_BACKEND_URL=https://api.stratacore.tech

# --- Charger OCPP endpoint (configure on the physical charger) ---
# ws://ocpp.stratacore.tech/ocpp/<chargerId>
# or wss://ocpp.stratacore.tech/ocpp/<chargerId> once TLS is enabled on OCPP
