PORT=4001
OCPP_WS_PORT=9000
OCPP_WS_PATH=/ocpp
PRICE_PER_KWH=15
JWT_SECRET=change-me-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production

# Maya Checkout
MAYA_ENV=sandbox
MAYA_PUBLIC_KEY=pk-...
MAYA_SECRET_KEY=sk-...
MAYA_API_BASE_URL=https://pg-sandbox.paymaya.com
MAYA_WEBHOOK_TOKEN=

# Redis (required in production Docker; optional in local dev)
REDIS_URL=redis://localhost:6379

GUEST_APP_URL=http://localhost:3002
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002

# Esquire RFID employee portal
RFID_STOP_BUFFER_KWH=5
OPERATOR_JWT_SECRET=change-me-in-production
OPERATOR_JWT_EXPIRE_MINUTES=480
TZ=Asia/Manila
RFID_RESET_CHECK_INTERVAL_MS=60000

# 3-charger site config (backend OCPP allowlist + kiosk site-config API)
STATION_NAME=Charging Station
STATION_LOCATION=
CHARGERS_JSON=[{"chargerId":"DELTA123","connectorId":1,"chargerIp":"192.168.137.51"},{"chargerId":"DELTA124","connectorId":1,"chargerIp":"192.168.137.52"},{"chargerId":"DELTA125","connectorId":1,"chargerIp":"192.168.137.53"}]

# Charge-start watchdog (no vehicle plugged in after RemoteStart)
CHARGE_START_TIMEOUT_MS=60000

# Stale session monitor (orphaned sessions after charger disconnect)
STALE_SESSION_THRESHOLD_MINUTES=10
STALE_SESSION_CHECK_INTERVAL_SECONDS=60
STALE_SESSION_MAX_RECOVERY_PER_CYCLE=10
STALE_SESSION_AUTOSTART=1

# In-process service watchdog
WATCHDOG_AUTOSTART=1
WATCHDOG_CHECK_INTERVAL_SECONDS=30
WATCHDOG_RESTART_COOLDOWN_SECONDS=60
WATCHDOG_MAX_RESTARTS_PER_HOUR=5

# Process health monitor
HEALTH_MONITOR_AUTOSTART=1
HEALTH_MONITOR_THRESHOLD=80
HEALTH_MONITOR_INTERVAL_SECONDS=30
