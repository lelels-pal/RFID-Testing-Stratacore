PORT=4001
BACKEND_PORT=4001

# JWT (EdgeTechEV-compatible)
JWT_SECRET_KEY=change-me-in-production-min-32-characters-long
JWT_SECRET=change-me-in-production-min-32-characters-long
ADMIN_INITIAL_PASSWORD=master123
ADMIN_DEFAULT_PASSWORD=master123

# Operator balance (EdgeTechEV)
OPERATOR_BASE_BALANCE=200
OPERATOR_MIN_BALANCE_KWH=5
PRICE_PER_KWH=15

# MySQL — same as EdgeTechEV config.env (set USE_SQLITE=true to force file mode)
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3305
DB_USER=ev3_user
DB_PASSWORD=admin123
DB_NAME=ev_charger_backend
USE_SQLITE=false
# Or set directly:
# DATABASE_URL=mysql://ev3_user:admin123@localhost:3305/ev_charger_backend

# OCPP (Stratacore default port 9000; EdgeTechEV uses 3005)
OCPP_WS_PORT=9000
OCPP_PORT=9000
OCPP_WS_PATH=/ocpp
OCPP_HOST=0.0.0.0

GUEST_APP_URL=http://localhost:3002
# CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002

PAYNAMICS_WEBHOOK_SECRET=change-me-in-production
PAYNAMICS_CHECKOUT_URL=https://www.paynamics.net/webpaymentservice/checkout

CHARGE_START_TIMEOUT_MS=60000
STALE_SESSION_THRESHOLD_MINUTES=10
STALE_SESSION_CHECK_INTERVAL_SECONDS=60
STALE_SESSION_MAX_RECOVERY_PER_CYCLE=10
STALE_SESSION_AUTOSTART=1

WATCHDOG_AUTOSTART=1
WATCHDOG_CHECK_INTERVAL_SECONDS=30
WATCHDOG_RESTART_COOLDOWN_SECONDS=60
WATCHDOG_MAX_RESTARTS_PER_HOUR=5

HEALTH_MONITOR_AUTOSTART=1
HEALTH_MONITOR_THRESHOLD=80
HEALTH_MONITOR_INTERVAL_SECONDS=30
