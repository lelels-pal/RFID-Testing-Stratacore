PORT=4001
OCPP_WS_PORT=9000
OCPP_WS_PATH=/ocpp
PRICE_PER_KWH=15
JWT_SECRET=change-me-in-production
PAYNAMICS_WEBHOOK_SECRET=change-me-in-production
PAYNAMICS_CHECKOUT_URL=https://www.paynamics.net/webpaymentservice/checkout
GUEST_APP_URL=http://localhost:3002

# Charge-start watchdog (no vehicle plugged in after RemoteStart)
CHARGE_START_TIMEOUT_MS=60000

# Stale session monitor (orphaned sessions after charger disconnect)
STALE_SESSION_THRESHOLD_MINUTES=10
STALE_SESSION_CHECK_INTERVAL_SECONDS=60
STALE_SESSION_MAX_RECOVERY_PER_CYCLE=10
STALE_SESSION_AUTOSTART=1

# In-process service watchdog (StrataSecure-style)
WATCHDOG_AUTOSTART=0
WATCHDOG_CHECK_INTERVAL_SECONDS=30
WATCHDOG_RESTART_COOLDOWN_SECONDS=60
WATCHDOG_MAX_RESTARTS_PER_HOUR=5
# WATCHDOG_RESTART_COMMAND=powershell -File tools/watchdog/restart-backend.ps1

# Process health monitor
HEALTH_MONITOR_AUTOSTART=1
HEALTH_MONITOR_THRESHOLD=80
HEALTH_MONITOR_INTERVAL_SECONDS=30
